{
  "name": "kids-games",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "童趣游戏屋 —— 为 3~6 岁儿童设计的 81 个寓教于乐网页小游戏。有设计感、有巧思、能反复玩。",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,css,md}\"",
    "test": "node --test --import tsx test/**/*.test.ts",
    "test:run": "node --test --import tsx test/**/*.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0"
  }
}
